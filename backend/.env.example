# SwiftSats Environment Variables Example
# Duplicate this file to .env and provide your actual secrets

# Django Configuration
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-to-a-secure-random-64-character-secret-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production/docker)
DATABASE_URL=postgres://swiftsats_user:swiftsats_password@localhost:5432/swiftsats_db

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Paystack API Configuration (Naira Collection via Virtual Accounts)
PAYSTACK_SECRET_KEY=sk_test_example_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_example_public_key_here
PAYSTACK_WEBHOOK_SECRET=sk_test_example_secret_key_here
PAYSTACK_BASE_URL=https://api.paystack.co

# Quidax API Configuration (Rates & Crypto Payout)
QUIDAX_API_KEY=sec_example_quidax_secret_key_here
QUIDAX_BASE_URL=https://app.quidax.com/api/v1
QUIDAX_RATE_SPREAD_PERCENTAGE=1.5

# Admin 2FA & Security
JWT_SECRET_KEY=change-me-jwt-signing-secret-here
ADMIN_SESSION_TIMEOUT_MINUTES=60

# Sentry (Optional for production monitoring)
SENTRY_DSN=
